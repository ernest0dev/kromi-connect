# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
# URL pública de la instancia de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (Segura para exponer en el navegador / cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# Clave de servicio de Supabase (SOLO USO EN SERVIDOR / Server Actions)
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui

# ==========================================
# GOOGLE DRIVE API (SERVICE ACCOUNT)
# ==========================================
# Correo electrónico de la Cuenta de Servicio (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=kromi-drive-bot@tu-proyecto.iam.gserviceaccount.com

# Clave privada descrita en el archivo JSON (Asegúrate de incluir comillas si tiene saltos de línea \n)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"

# ID de la carpeta raíz principal en Google Drive compartida con el bot
GOOGLE_DRIVE_PARENT_FOLDER_ID=id_de_la_carpeta_raiz_en_drive